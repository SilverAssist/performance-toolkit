{
  "name": "@silverassist/performance-toolkit",
  "version": "0.5.2",
  "description": "PageSpeed Insights and Lighthouse CI integration for performance monitoring across SilverAssist projects",
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "overrides": {
    "cookie": "^0.7.2",
    "tmp": "^0.2.3",
    "uuid": "^11.1.1",
    "js-yaml": "^4.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.0"
    },
    "@lhci/utils": {
      "js-yaml": "^3.15.0"
    },
    "qs": "^6.15.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverAssist/performance-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/SilverAssist/performance-toolkit/issues"
  },
  "homepage": "https://github.com/SilverAssist/performance-toolkit#readme",
  "keywords": [
    "pagespeed",
    "lighthouse",
    "performance",
    "core-web-vitals",
    "lcp",
    "fcp",
    "cls",
    "tbt",
    "nextjs",
    "ci-cd",
    "monitoring"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "perf-check": "./bin/cli.js",
    "perf-bundle": "./bin/bundle-cli.js",
    "perf-prompts": "./bin/install-prompts.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pagespeed": {
      "import": {
        "types": "./dist/pagespeed/index.d.ts",
        "default": "./dist/pagespeed/index.js"
      },
      "require": {
        "types": "./dist/pagespeed/index.d.cts",
        "default": "./dist/pagespeed/index.cjs"
      }
    },
    "./lighthouse": {
      "import": {
        "types": "./dist/lighthouse/index.d.ts",
        "default": "./dist/lighthouse/index.js"
      },
      "require": {
        "types": "./dist/lighthouse/index.d.cts",
        "default": "./dist/lighthouse/index.cjs"
      }
    },
    "./bundle": {
      "import": {
        "types": "./dist/bundle/index.d.ts",
        "default": "./dist/bundle/index.js"
      },
      "require": {
        "types": "./dist/bundle/index.d.cts",
        "default": "./dist/bundle/index.cjs"
      }
    },
    "./analyzer": {
      "import": {
        "types": "./dist/analyzer/index.d.ts",
        "default": "./dist/analyzer/index.js"
      },
      "require": {
        "types": "./dist/analyzer/index.d.cts",
        "default": "./dist/analyzer/index.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./dist/context/index.d.ts",
        "default": "./dist/context/index.js"
      },
      "require": {
        "types": "./dist/context/index.d.cts",
        "default": "./dist/context/index.cjs"
      }
    },
    "./report": {
      "import": {
        "types": "./dist/report/index.d.ts",
        "default": "./dist/report/index.js"
      },
      "require": {
        "types": "./dist/report/index.d.cts",
        "default": "./dist/report/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "pagespeed": [
        "./dist/pagespeed/index.d.ts"
      ],
      "lighthouse": [
        "./dist/lighthouse/index.d.ts"
      ],
      "bundle": [
        "./dist/bundle/index.d.ts"
      ],
      "analyzer": [
        "./dist/analyzer/index.d.ts"
      ],
      "context": [
        "./dist/context/index.d.ts"
      ],
      "report": [
        "./dist/report/index.d.ts"
      ],
      "types": [
        "./dist/types/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "bin",
    "src/templates/prompts",
    "src/templates/skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.js\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "release": "npm run prepublishOnly && npm publish --access public",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "@lhci/cli": ">=0.12.0",
    "@next/bundle-analyzer": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@lhci/cli": {
      "optional": true
    },
    "@next/bundle-analyzer": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
